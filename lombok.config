# Racine de la configuration Lombok : ne pas remonter au-dessus du projet.
config.stopBubbling = true

# Annote le code genere par Lombok avec @lombok.Generated.
#
# JaCoCo ignore les methodes portant cette annotation. Sans elle, les
# equals()/hashCode()/toString() et les builders generes sont comptes comme du
# code non couvert : chaque champ y ajoute deux branches de test de nullite,
# ce qui represente plusieurs centaines de branches "manquantes" a l'echelle du
# projet, sur du code que personne n'a ecrit et qu'aucun test ne couvrira.
lombok.addLombokGeneratedAnnotation = true
